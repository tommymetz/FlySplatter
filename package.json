{
  "name": "flysplatter",
  "version": "2.0.1",
  "description": "Splatter those pesky flies you hate so much in the Fly Splatter game!!!",
  "author": "Tom Metz Media LLC",
  "license": "MIT",
  "homepage": "https://flysplatter.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tommymetz/flysplatter.git"
  },
  "type": "module",
  "main": "./dist/lib/flysplatter.js",
  "module": "./dist/lib/flysplatter.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/flysplatter.js"
    }
  },
  "files": [
    "dist/lib"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "prepare": "npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
